# App runtime
NODE_ENV="production"
APP_ENV="staging"
CORS_ALLOWED_ORIGINS="https://your-vercel-staging-url.vercel.app"

# Database
# Use the pooled URL for the app runtime.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"
# Use the direct URL for Prisma migrations and admin tasks.
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# Auth
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN_SECONDS=86400
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=300
RESET_PASSWORD_TOKEN_EXPIRES_IN_SECONDS=600

# Mail transport
# Set RESEND_API_KEY to use Resend.
# Important: resend.dev is only for testing to your own Resend account email.
# For shared staging or production, use a verified domain like
# no-reply@mail.yourdomain.com or onboarding@mail.yourdomain.com.
RESEND_API_KEY=""
MAIL_FROM="onboarding@mail.yourdomain.com"

# Redis / BullMQ
MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_CONCURRENCY=2
REDIS_URL="redis://<render-key-value-internal-url>"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-render-backend-url.onrender.com/api/v1/auth/google/callback"
GOOGLE_FRONTEND_CALLBACK_URL="https://your-vercel-staging-url.vercel.app/auth/google/callback"

# Superadmin bootstrap
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Platform Super Admin"

# Storage
STORAGE_PROVIDER="vps"
STORAGE_ENV="staging"
VPS_STORAGE_API_URL="http://gr8booksneo-storage.integr8.com.ph/api/v1/storage/internal"
VPS_STORAGE_PUBLIC_URL="http://gr8booksneo-storage.integr8.com.ph"
VPS_STORAGE_SECRET="replace-with-shared-storage-secret"

# Required only when STORAGE_PROVIDER="supabase".
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# PayMongo billing
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_API_BASE_URL="https://api.paymongo.com/v1"
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
