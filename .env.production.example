# Production runtime
PORT=3000
NODE_ENV="production"

# Production database
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# Direct connection for Prisma CLI tasks
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

JWT_SECRET="replace-with-a-strong-production-secret"
JWT_EXPIRES_IN_SECONDS=86400

EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=300

MAIL_FROM="no-reply@example.com"
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""

SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Platform Super Admin"
