# App runtime
PORT=3000
NODE_ENV="development"
APP_ENV="local"
CORS_ALLOWED_ORIGINS="http://localhost:3001"

# Local PostgreSQL only. Render receives Neon URLs from its environment settings.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/gr8booksneo_dev?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/gr8booksneo_dev?schema=public"

# Required for staging and production database commands. Neon pooled and direct
# URLs may use different hosts, so provide a comma-separated host allowlist.
# DATABASE_GUARD_HOSTS="pooled-host.example.com,direct-host.example.com"
# DATABASE_GUARD_NAME="gr8booksneo_staging"
# CONFIRM_PRODUCTION_MIGRATION="true"
# CONFIRM_PRODUCTION_REFERENCE_SEED="true"

# Auth
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN_SECONDS=86400
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=300
RESET_PASSWORD_TOKEN_EXPIRES_IN_SECONDS=600

# Mail transport
RESEND_API_KEY=""
MAIL_FROM="no-reply@example.com"

# Redis / BullMQ
# Set to true when local Redis is running.
MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_CONCURRENCY=2
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB=0

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
GOOGLE_FRONTEND_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Superadmin bootstrap
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Platform Super Admin"

# Supabase storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# PayMongo billing
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_API_BASE_URL="https://api.paymongo.com/v1"
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_ALLOW_PROVIDER_FALLBACK=false

# AI assistant
GEMINI_API_KEY=""
