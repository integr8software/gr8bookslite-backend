    "db:status:production": "node scripts/run-with-process-env.cjs production prisma migrate status",
    "db:studio:shared": "node scripts/run-with-env.cjs .env.shared-dev prisma studio",
    "sync:push": "npm run db:verify-migrations:shared && npm run db:migrate:shared && npm run db:verify:shared",
