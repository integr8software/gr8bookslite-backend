    "db:migrate:shared": "npm run db:verify-migrations:shared && node scripts/run-with-env.cjs .env.shared-dev prisma migrate deploy",
    "db:migrate:staging": "npm run db:verify-migrations:staging && node scripts/run-with-process-env.cjs staging prisma migrate deploy",
