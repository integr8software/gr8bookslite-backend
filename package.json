    "start:staging": "node scripts/run-with-process-env.cjs staging node dist/src/main.js",
    "start:production": "node scripts/run-with-process-env.cjs production node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "openapi:generate": "npm run build && node dist/src/scripts/generate-openapi.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:clean": "rm -f tsconfig.tsbuildinfo && npm run typecheck"
