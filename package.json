    "db:repair:legacy-company-subscriptions:staging": "node scripts/run-with-process-env.cjs staging ts-node prisma/scripts/repair-legacy-company-subscriptions.ts",
    "db:audit:company-bootstrap:local": "node scripts/run-with-env.cjs .env ts-node prisma/scripts/repair-company-bootstrap.ts",
    "db:audit:company-bootstrap:shared": "node scripts/run-with-env.cjs .env.shared-dev ts-node prisma/scripts/repair-company-bootstrap.ts",
    "db:audit:company-bootstrap:staging": "node scripts/run-with-process-env.cjs staging ts-node prisma/scripts/repair-company-bootstrap.ts",
    "db:repair:company-bootstrap:local": "node scripts/run-with-env.cjs .env ts-node prisma/scripts/repair-company-bootstrap.ts",
