    "db:verify-migrations:staging": "node scripts/run-with-process-env.cjs staging ts-node prisma/scripts/verifyMigrationHistory.ts",
    "db:verify-migrations:production": "node scripts/run-with-process-env.cjs production ts-node prisma/scripts/verifyMigrationHistory.ts",
