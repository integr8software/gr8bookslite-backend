{
  "name": "erp-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "npm run db:generate:local && node scripts/run-with-env.cjs .env nest start --watch",
    "dev:debug": "npm run db:generate:local && node scripts/run-with-env.cjs .env nest start --debug --watch",
    "dev:clean": "rm -f tsconfig.tsbuildinfo && npm run dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "postinstall": "node scripts/generate-prisma-client.cjs",
    "db:generate:local": "node scripts/run-with-env.cjs .env prisma generate",
    "db:validate:local": "node scripts/run-with-env.cjs .env prisma validate",
    "db:format": "node scripts/run-with-env.cjs .env prisma format",
    "db:migrate:local": "node scripts/run-with-env.cjs .env prisma migrate dev",
    "db:migrate:create:local": "node scripts/run-with-env.cjs .env prisma migrate dev --create-only",
    "db:status:local": "node scripts/run-with-env.cjs .env prisma migrate status",
    "db:reset:local": "node scripts/run-with-env.cjs .env prisma migrate reset --force",
    "db:rebuild:local": "npm run db:reset:local -- --skip-seed && npm run db:generate:local && npm run db:seed:local",
    "db:prepare:local": "npm run db:format && npm run db:validate:local && npm run db:generate:local",
    "db:seed:local": "node scripts/run-with-env.cjs .env prisma db seed",
    "db:delete-user-owned-data:local": "node scripts/run-with-env.cjs .env ts-node prisma/scripts/deleteUserOwnedData.ts",
    "db:backfill-head-offices:local": "node scripts/run-with-env.cjs .env ts-node prisma/scripts/backfillCompanyHeadOffices.ts",
    "db:studio:local": "node scripts/run-with-env.cjs .env prisma studio",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "openapi:generate": "npm run build && node dist/src/scripts/generate-openapi.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:clean": "rm -f tsconfig.tsbuildinfo && npm run typecheck"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.18.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.10",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.18.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
