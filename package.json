  "scripts": {
    "build": "nest build",
    "dev": "npm run dev:local",
    "dev:local": "node scripts/generate-prisma-if-needed.cjs .env && node scripts/run-with-env.cjs .env nest start --watch --config nest-cli.dev.json",
    "dev:shared": "node scripts/generate-prisma-if-needed.cjs .env.shared-dev && node scripts/run-with-env.cjs .env.shared-dev nest start --watch --config nest-cli.dev.json",
    "db:generate:shared": "node scripts/run-with-env.cjs .env.shared-dev prisma generate",
