generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId            Int                     @id @default(autoincrement()) @map("user_id")
  email             String                  @unique
  passwordHash      String                  @map("password_hash")
  name              String
  dateOfBirth       DateTime?               @map("date_of_birth")
  systemRole        SystemRole              @default(STANDARD) @map("system_role")
  status            UserStatus              @default(PENDING_VERIFICATION)
  isActive          Boolean                 @default(true) @map("is_active")
  emailVerifiedAt   DateTime?               @map("email_verified_at")
  verificationCodes EmailVerificationCode[]
  memberships       Membership[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@map("users")
}

model Company {
  companyId        Int                   @id @default(autoincrement()) @map("company_id")
  name             String
  slug             String                @unique
  isActive         Boolean               @default(true) @map("is_active")
  status           CompanyStatus         @default(PENDING)
  memberships      Membership[]
  tenantConnection TenantConnection?
  subscriptions    CompanySubscription[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@map("companies")
}

model Membership {
  membershipId Int            @id @default(autoincrement()) @map("membership_id")
  userId       Int            @map("user_id")
  companyId    Int            @map("company_id")
  role         MembershipRole @default(USER)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  company      Company        @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("memberships")
}

model TenantConnection {
  tenantConnectionId Int          @id @default(autoincrement()) @map("tenant_connection_id")
  companyId          Int          @unique @map("company_id")
  dbName             String       @unique @map("db_name")
  databaseUrl        String       @map("database_url")
  status             TenantStatus @default(PENDING)
  schemaVersion      String?      @map("schema_version")
  lastCheckedAt      DateTime?    @map("last_checked_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  company            Company      @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  @@map("tenant_connections")
}

model SubscriptionPlan {
  subscriptionPlanId Int                   @id @default(autoincrement()) @map("subscription_plan_id")
  code               String                @unique
  name               String
  description        String?
  trialDays          Int                   @default(15) @map("trial_days")
  isActive           Boolean               @default(true) @map("is_active")
  subscriptions      CompanySubscription[]
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model CompanySubscription {
  companySubscriptionId Int                @id @default(autoincrement()) @map("company_subscription_id")
  companyId             Int                @map("company_id")
  subscriptionPlanId    Int                @map("subscription_plan_id")
  status                SubscriptionStatus @default(TRIALING)
  startsAt              DateTime           @default(now()) @map("starts_at")
  trialEndsAt           DateTime?          @map("trial_ends_at")
  endsAt                DateTime?          @map("ends_at")
  canceledAt            DateTime?          @map("canceled_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  company               Company            @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  plan                  SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [subscriptionPlanId], onDelete: Restrict)

  @@index([companyId])
  @@index([subscriptionPlanId])
  @@index([status])
  @@map("company_subscriptions")
}

model EmailVerificationCode {
  emailVerificationCodeId Int                 @id @default(autoincrement()) @map("email_verification_code_id")
  userId                  Int                 @map("user_id")
  email                   String
  purpose                 VerificationPurpose @default(SIGNUP)
  codeHash                String              @map("code_hash")
  expiresAt               DateTime            @map("expires_at")
  consumedAt              DateTime?           @map("consumed_at")
  resendCount             Int                 @default(0) @map("resend_count")
  attemptCount            Int                 @default(0) @map("attempt_count")
  lastSentAt              DateTime            @default(now()) @map("last_sent_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  user                    User                @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@map("email_verification_codes")
}

enum SystemRole {
  SUPER_ADMIN
  STANDARD
}

enum MembershipRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum CompanyStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  SUSPENDED
}

enum TenantStatus {
  PENDING
  ACTIVE
  FAILED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

enum VerificationPurpose {
  SIGNUP
  EMAIL_CHANGE
  PASSWORD_RESET
}
