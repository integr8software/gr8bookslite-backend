// Onboarding
// =========================================================

/// Temporary pre-company onboarding storage.
/// This does not represent an active subscription owner.
/// The real subscription must be created under CompanySubscription
/// after company details are completed and a company record exists.
model UserOnboardingDraft {
  id                        Int               @id @default(autoincrement())
  userId                    Int               @unique @map("user_id")
  subscriptionPlanId        Int?              @map("subscription_plan_id")
  provisionedCompanyId      Int?              @unique @map("provisioned_company_id")
  taxpayerType              TaxpayerType?     @map("taxpayer_type")
  ownerLastName             String?           @map("owner_last_name")
  ownerFirstName            String?           @map("owner_first_name")
  ownerMiddleName           String?           @map("owner_middle_name")
  companyName               String?           @map("company_name")
  organizationType          String?           @map("organization_type")
  organizationTypeOther     String?           @map("organization_type_other")
  logoFileName              String?           @map("logo_file_name")
  logoMimeType              String?           @map("logo_mime_type")
  logoStoragePath           String?           @map("logo_storage_path")
  logoPublicUrl             String?           @map("logo_public_url")
  address                   String?
  tin                       String?
  companyEmail              String?           @map("company_email")
  website                   String?
  contactNumber             String?           @map("contact_number")
  reportStartDate           DateTime?         @map("report_start_date")
  reportEndDate             DateTime?         @map("report_end_date")
  billingCycle              BillingCycle?
  cardholderName            String?           @map("cardholder_name")
  billingEmail              String?           @map("billing_email")
  billingAddress            String?           @map("billing_address")
  cardLast4                 String?           @map("card_last4")
  cardBrand                 String?           @map("card_brand")
  cardExpiryMonth           Int?              @map("card_expiry_month")
  cardExpiryYear            Int?              @map("card_expiry_year")
  paymentMethodReference    String?           @map("payment_method_reference")
  planSelectedAt            DateTime?         @map("plan_selected_at")
  billingCompletedAt        DateTime?         @map("billing_completed_at")
  companyDetailsCompletedAt DateTime?         @map("company_details_completed_at")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan          SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  provisionedCompany        Company?          @relation("ProvisionedOnboardingCompany", fields: [provisionedCompanyId], references: [id], onDelete: SetNull)

  @@index([subscriptionPlanId])
  @@index([provisionedCompanyId])
  @@index([billingCompletedAt])
  @@map("user_onboarding_drafts")
}

model CompanySubscription {
  id                      Int                    @id @default(autoincrement())
  companyId               Int                    @map("company_id")
  subscriptionPlanId      Int                    @map("subscription_plan_id")
  subscriptionPlanPriceId Int?                   @map("subscription_plan_price_id")
  billingCustomerId       Int?                   @map("billing_customer_id")
  billingCycle            BillingCycle           @default(MONTHLY) @map("billing_cycle")
  billingProvider         BillingProvider        @default(PAYMONGO) @map("billing_provider")
  status                  SubscriptionStatus     @default(TRIALING)
  externalCustomerId      String?                @map("external_customer_id")
  externalSubscriptionId  String?                @unique @map("external_subscription_id")
  externalPlanId          String?                @map("external_plan_id")
  externalPaymentMethodId String?                @map("external_payment_method_id")
  latestInvoiceExternalId String?                @map("latest_invoice_external_id")
  latestPaymentIntentId   String?                @map("latest_payment_intent_id")
  cancelAtPeriodEnd       Boolean                @default(false) @map("cancel_at_period_end")
  currentPeriodStartAt    DateTime?              @map("current_period_start_at")
  nextBillingAt           DateTime?              @map("next_billing_at")
  failureCode             String?                @map("failure_code")
  failureMessage          String?                @map("failure_message")
  rawProviderPayload      Json?                  @map("raw_provider_payload")
  startsAt                DateTime               @default(now()) @map("starts_at")
  trialEndsAt             DateTime?              @map("trial_ends_at")
  endsAt                  DateTime?              @map("ends_at")
  canceledAt              DateTime?              @map("canceled_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [id])
  planPrice               SubscriptionPlanPrice? @relation(fields: [subscriptionPlanPriceId], references: [id], onDelete: SetNull)
  billingCustomer         BillingCustomer?       @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  invoices                SubscriptionInvoice[]
  paymentMethods          BillingPaymentMethod[]

  @@index([companyId])
  @@index([subscriptionPlanId])
  @@index([subscriptionPlanPriceId])
  @@index([billingCustomerId])
  @@index([status])
  @@index([companyId, status])
  @@map("company_subscriptions")
}

model BillingCustomer {
  id                 Int                   @id @default(autoincrement())
  companyId          Int                   @map("company_id")
  ownerUserId        Int?                  @map("owner_user_id")
  billingProvider    BillingProvider       @default(PAYMONGO) @map("billing_provider")
  externalCustomerId String                @unique @map("external_customer_id")
  email              String
  name               String
  phone              String?
  metadata           Json?
  rawProviderPayload Json?                 @map("raw_provider_payload")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerUser          User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  subscriptions      CompanySubscription[]

  @@unique([companyId, billingProvider])
  @@index([ownerUserId])
  @@map("billing_customers")
}

model SubscriptionInvoice {
  id                      Int                 @id @default(autoincrement())
  companySubscriptionId   Int                 @map("company_subscription_id")
  billingProvider         BillingProvider     @default(PAYMONGO) @map("billing_provider")
  externalInvoiceId       String              @unique @map("external_invoice_id")
  externalPaymentIntentId String?             @map("external_payment_intent_id")
  status                  String
  billingReason           String?             @map("billing_reason")
  currency                String              @default("PHP")
  amountDueInCents        Int?                @map("amount_due_in_cents")
  amountPaidInCents       Int?                @map("amount_paid_in_cents")
  dueAt                   DateTime?           @map("due_at")
  paidAt                  DateTime?           @map("paid_at")
  finalizedAt             DateTime?           @map("finalized_at")
  periodStartAt           DateTime?           @map("period_start_at")
  periodEndAt             DateTime?           @map("period_end_at")
  rawProviderPayload      Json?               @map("raw_provider_payload")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  companySubscription     CompanySubscription @relation(fields: [companySubscriptionId], references: [id], onDelete: Cascade)

  @@index([companySubscriptionId])
  @@index([status])
  @@map("subscription_invoices")
}

model BillingPaymentMethod {
  id                      Int                  @id @default(autoincrement())
  companyId               Int                  @map("company_id")
  companySubscriptionId   Int?                 @map("company_subscription_id")
  ownerUserId             Int?                 @map("owner_user_id")
  billingProvider         BillingProvider      @default(PAYMONGO) @map("billing_provider")
  externalPaymentMethodId String               @unique @map("external_payment_method_id")
  type                    String
  brand                   String?
  last4                   String?
  expMonth                Int?                 @map("exp_month")
  expYear                 Int?                 @map("exp_year")
  isDefault               Boolean              @default(false) @map("is_default")
  metadata                Json?
  rawProviderPayload      Json?                @map("raw_provider_payload")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companySubscription     CompanySubscription? @relation(fields: [companySubscriptionId], references: [id], onDelete: SetNull)
  ownerUser               User?                @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companySubscriptionId])
  @@index([ownerUserId])
  @@index([isDefault])
  @@map("billing_payment_methods")
}

model BillingWebhookEvent {
  id                 BigInt                  @id @default(autoincrement())
  billingProvider    BillingProvider         @default(PAYMONGO) @map("billing_provider")
  eventId            String                  @map("event_id")
  eventType          String                  @map("event_type")
  isLiveMode         Boolean                 @default(false) @map("is_live_mode")
  signature          String?
  payload            Json
  processingStatus   WebhookProcessingStatus @default(PENDING) @map("processing_status")
  processingAttempts Int                     @default(0) @map("processing_attempts")
  processedAt        DateTime?               @map("processed_at")
  lastError          String?                 @map("last_error")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@unique([billingProvider, eventId])
  @@index([eventType])
  @@index([processingStatus])
  @@map("billing_webhook_events")
}

model EmailVerificationCode {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @map("user_id")
  email        String
  purpose      VerificationPurpose @default(SIGNUP)
  codeHash     String              @map("code_hash")
  expiresAt    DateTime            @map("expires_at")
  consumedAt   DateTime?           @map("consumed_at")
  resendCount  Int                 @default(0) @map("resend_count")
  attemptCount Int                 @default(0) @map("attempt_count")
  lastSentAt   DateTime            @default(now()) @map("last_sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@map("email_verification_codes")
}

