generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// Core Auth
// =========================================================

model User {
  id                 Int                     @id @default(autoincrement())
  email              String                  @unique
  passwordHash       String                  @map("password_hash")
  name               String
  contactNumber      String?                 @map("contact_number")
  avatarFileName     String?                 @map("avatar_file_name")
  avatarMimeType     String?                 @map("avatar_mime_type")
  avatarStoragePath  String?                 @map("avatar_storage_path")
  avatarPublicUrl    String?                 @map("avatar_public_url")
  systemRole         SystemRole              @default(STANDARD) @map("system_role")
  status             UserStatus              @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?               @map("email_verified_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  verificationCodes  EmailVerificationCode[]
  memberships        Membership[]
  invitedMemberships Membership[]            @relation("MembershipInvitedBy")
  createdAuditLogs   AuditLog[]              @relation("AuditActor")
  targetedAuditLogs  AuditLog[]              @relation("AuditTargetUser")
  onboardingDraft    UserOnboardingDraft?
  billingCustomers   BillingCustomer[]

  @@map("users")
}

// =========================================================
// Company & Access Control
// =========================================================

model Company {
  id                    Int                    @id @default(autoincrement())
  name                  String
  slug                  String                 @unique
  legalName             String?                @map("legal_name")
  companyCode           String?                @unique @map("company_code")
  taxpayerType          TaxpayerType?          @map("taxpayer_type")
  ownerLastName         String?                @map("owner_last_name")
  ownerFirstName        String?                @map("owner_first_name")
  ownerMiddleName       String?                @map("owner_middle_name")
  organizationType      String?                @map("organization_type")
  organizationTypeOther String?                @map("organization_type_other")
  logoFileName          String?                @map("logo_file_name")
  logoMimeType          String?                @map("logo_mime_type")
  logoStoragePath       String?                @map("logo_storage_path")
  logoPublicUrl         String?                @map("logo_public_url")
  address               String?
  tin                   String?
  website               String?
  contactNumber         String?                @map("contact_number")
  reportStartDate       DateTime?              @map("report_start_date")
  reportEndDate         DateTime?              @map("report_end_date")
  isActive              Boolean                @default(true) @map("is_active")
  status                CompanyStatus          @default(PENDING)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  subscriptions         CompanySubscription[]
  billingCustomers      BillingCustomer[]
  billingPaymentMethods BillingPaymentMethod[]
  memberships           Membership[]
  roles                 CompanyRole[]
  enabledModules        CompanyModule[]
  units                 CompanyUnit[]
  auditLogs             AuditLog[]
  onboardingDrafts      UserOnboardingDraft[]  @relation("ProvisionedOnboardingCompany")

  @@map("companies")
}

model CompanyUnit {
  id                     Int             @id @default(autoincrement())
  companyId              Int             @map("company_id")
  parentUnitId           Int?            @map("parent_unit_id")
  type                   CompanyUnitType
  code                   String?
  name                   String
  displayName            String?         @map("display_name")
  tin                    String?
  address                String?
  contactNumber          String?         @map("contact_number")
  email                  String?
  isActive               Boolean         @default(true) @map("is_active")
  inheritsCompanyProfile Boolean         @default(false) @map("inherits_company_profile")
  canTransactSales       Boolean         @default(false) @map("can_transact_sales")
  canHoldInventory       Boolean         @default(false) @map("can_hold_inventory")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  company                Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentUnit             CompanyUnit?    @relation("CompanyUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits             CompanyUnit[]   @relation("CompanyUnitHierarchy")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentUnitId])
  @@map("company_units")
}

model Membership {
  userId              Int                    @map("user_id")
  companyId           Int                    @map("company_id")
  role                MembershipRole         @default(USER)
  companyRoleId       Int?                   @map("company_role_id")
  status              MembershipStatus       @default(ACTIVE)
  accessScope         AccessScopeLevel       @default(COMPANY) @map("access_scope")
  invitedByUserId     Int?                   @map("invited_by_user_id")
  invitedAt           DateTime?              @map("invited_at")
  joinedAt            DateTime?              @map("joined_at")
  suspendedAt         DateTime?              @map("suspended_at")
  lastAccessedAt      DateTime?              @map("last_accessed_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyRole         CompanyRole?           @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)
  invitedBy           User?                  @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  permissionOverrides MembershipPermission[]

  @@id([userId, companyId])
  @@index([companyId])
  @@index([companyRoleId])
  @@index([status])
  @@index([companyId, status])
  @@map("memberships")
}

model CompanyRole {
  id          Int                     @id @default(autoincrement())
  companyId   Int                     @map("company_id")
  code        String
  name        String
  description String?
  roleType    CompanyRoleType         @default(CUSTOM) @map("role_type")
  scopeLevel  AccessScopeLevel        @default(COMPANY) @map("scope_level")
  isSystem    Boolean                 @default(false) @map("is_system")
  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions CompanyRolePermission[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("company_roles")
}

model PlatformModule {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  description      String?
  sortOrder        Int             @default(0) @map("sort_order")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  permissions      Permission[]
  enabledCompanies CompanyModule[]
  auditLogs        AuditLog[]

  @@map("platform_modules")
}

model Permission {
  id                     Int                     @id @default(autoincrement())
  moduleId               Int                     @map("module_id")
  code                   String                  @unique
  name                   String
  description            String?
  scopeLevel             AccessScopeLevel        @default(COMPANY) @map("scope_level")
  requiresCompanyContext Boolean                 @default(true) @map("requires_company_context")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  module                 PlatformModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rolePermissions        CompanyRolePermission[]
  membershipOverrides    MembershipPermission[]

  @@unique([moduleId, code])
  @@index([moduleId, isActive])
  @@map("permissions")
}

model CompanyRolePermission {
  id            Int         @id @default(autoincrement())
  companyRoleId Int         @map("company_role_id")
  permissionId  Int         @map("permission_id")
  canView       Boolean     @default(false) @map("can_view")
  canCreate     Boolean     @default(false) @map("can_create")
  canUpdate     Boolean     @default(false) @map("can_update")
  canDelete     Boolean     @default(false) @map("can_delete")
  canApprove    Boolean     @default(false) @map("can_approve")
  canExport     Boolean     @default(false) @map("can_export")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  companyRole   CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([companyRoleId, permissionId])
  @@index([permissionId])
  @@map("company_role_permissions")
}

model MembershipPermission {
  id                  Int        @id @default(autoincrement())
  membershipUserId    Int        @map("membership_user_id")
  membershipCompanyId Int        @map("membership_company_id")
  permissionId        Int        @map("permission_id")
  canView             Boolean?   @map("can_view")
  canCreate           Boolean?   @map("can_create")
  canUpdate           Boolean?   @map("can_update")
  canDelete           Boolean?   @map("can_delete")
  canApprove          Boolean?   @map("can_approve")
  canExport           Boolean?   @map("can_export")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  membership          Membership @relation(fields: [membershipUserId, membershipCompanyId], references: [userId, companyId], onDelete: Cascade)
  permission          Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipUserId, membershipCompanyId, permissionId])
  @@index([permissionId])
  @@index([membershipCompanyId])
  @@map("membership_permissions")
}

model CompanyModule {
  id         Int            @id @default(autoincrement())
  companyId  Int            @map("company_id")
  moduleId   Int            @map("module_id")
  isEnabled  Boolean        @default(true) @map("is_enabled")
  enabledAt  DateTime?      @map("enabled_at")
  disabledAt DateTime?      @map("disabled_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module     PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@index([moduleId])
  @@index([companyId, isEnabled])
  @@map("company_modules")
}

model AuditLog {
  id           BigInt          @id @default(autoincrement())
  companyId    Int?            @map("company_id")
  actorUserId  Int?            @map("actor_user_id")
  targetUserId Int?            @map("target_user_id")
  moduleId     Int?            @map("module_id")
  action       String
  entityType   String          @map("entity_type")
  entityId     String?         @map("entity_id")
  metadata     Json?
  ipAddress    String?         @map("ip_address")
  userAgent    String?         @map("user_agent")
  createdAt    DateTime        @default(now()) @map("created_at")
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUser    User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?           @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  module       PlatformModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =========================================================
// Billing
// =========================================================

model SubscriptionPlan {
  id                      Int                   @id @default(autoincrement())
  code                    String                @unique
  name                    String
  description             String?
  currency                String                @default("PHP")
  monthlyPriceInCents     Int                   @map("monthly_price_in_cents")
  yearlyPriceInCents      Int                   @map("yearly_price_in_cents")
  monthlyCompareAtInCents Int?                  @map("monthly_compare_at_in_cents")
  yearlyCompareAtInCents  Int?                  @map("yearly_compare_at_in_cents")
  monthlyExternalPlanId   String?               @unique @map("monthly_external_plan_id")
  yearlyExternalPlanId    String?               @unique @map("yearly_external_plan_id")
  billingProvider         BillingProvider       @default(PAYMONGO) @map("billing_provider")
  billingMetadata         Json?                 @map("billing_metadata")
  trialDays               Int                   @default(15) @map("trial_days")
  isActive                Boolean               @default(true) @map("is_active")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  subscriptions           CompanySubscription[]
  onboardingDrafts        UserOnboardingDraft[]

  @@map("subscription_plans")
}

// =========================================================
// Onboarding
// =========================================================

/// Temporary pre-company onboarding storage.
/// This does not represent an active subscription owner.
/// The real subscription must be created under CompanySubscription
/// after company details are completed and a company record exists.
model UserOnboardingDraft {
  id                        Int               @id @default(autoincrement())
  userId                    Int               @unique @map("user_id")
  subscriptionPlanId        Int?              @map("subscription_plan_id")
  provisionedCompanyId      Int?              @unique @map("provisioned_company_id")
  taxpayerType              TaxpayerType?     @map("taxpayer_type")
  ownerLastName             String?           @map("owner_last_name")
  ownerFirstName            String?           @map("owner_first_name")
  ownerMiddleName           String?           @map("owner_middle_name")
  companyName               String?           @map("company_name")
  organizationType          String?           @map("organization_type")
  organizationTypeOther     String?           @map("organization_type_other")
  logoFileName              String?           @map("logo_file_name")
  logoMimeType              String?           @map("logo_mime_type")
  logoStoragePath           String?           @map("logo_storage_path")
  logoPublicUrl             String?           @map("logo_public_url")
  address                   String?
  tin                       String?
  website                   String?
  contactNumber             String?           @map("contact_number")
  reportStartDate           DateTime?         @map("report_start_date")
  reportEndDate             DateTime?         @map("report_end_date")
  billingCycle              BillingCycle?
  cardholderName            String?           @map("cardholder_name")
  billingEmail              String?           @map("billing_email")
  billingAddress            String?           @map("billing_address")
  cardLast4                 String?           @map("card_last4")
  cardBrand                 String?           @map("card_brand")
  cardExpiryMonth           Int?              @map("card_expiry_month")
  cardExpiryYear            Int?              @map("card_expiry_year")
  paymentMethodReference    String?           @map("payment_method_reference")
  planSelectedAt            DateTime?         @map("plan_selected_at")
  billingCompletedAt        DateTime?         @map("billing_completed_at")
  companyDetailsCompletedAt DateTime?         @map("company_details_completed_at")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan          SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  provisionedCompany        Company?          @relation("ProvisionedOnboardingCompany", fields: [provisionedCompanyId], references: [id], onDelete: SetNull)

  @@index([subscriptionPlanId])
  @@index([provisionedCompanyId])
  @@index([billingCompletedAt])
  @@map("user_onboarding_drafts")
}

model CompanySubscription {
  id                      Int                    @id @default(autoincrement())
  companyId               Int                    @map("company_id")
  subscriptionPlanId      Int                    @map("subscription_plan_id")
  billingCustomerId       Int?                   @map("billing_customer_id")
  billingCycle            BillingCycle           @default(MONTHLY) @map("billing_cycle")
  billingProvider         BillingProvider        @default(PAYMONGO) @map("billing_provider")
  status                  SubscriptionStatus     @default(TRIALING)
  externalCustomerId      String?                @map("external_customer_id")
  externalSubscriptionId  String?                @unique @map("external_subscription_id")
  externalPlanId          String?                @map("external_plan_id")
  externalPaymentMethodId String?                @map("external_payment_method_id")
  latestInvoiceExternalId String?                @map("latest_invoice_external_id")
  latestPaymentIntentId   String?                @map("latest_payment_intent_id")
  cancelAtPeriodEnd       Boolean                @default(false) @map("cancel_at_period_end")
  currentPeriodStartAt    DateTime?              @map("current_period_start_at")
  nextBillingAt           DateTime?              @map("next_billing_at")
  failureCode             String?                @map("failure_code")
  failureMessage          String?                @map("failure_message")
  rawProviderPayload      Json?                  @map("raw_provider_payload")
  startsAt                DateTime               @default(now()) @map("starts_at")
  trialEndsAt             DateTime?              @map("trial_ends_at")
  endsAt                  DateTime?              @map("ends_at")
  canceledAt              DateTime?              @map("canceled_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [id])
  billingCustomer         BillingCustomer?       @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  invoices                SubscriptionInvoice[]
  paymentMethods          BillingPaymentMethod[]

  @@index([companyId])
  @@index([subscriptionPlanId])
  @@index([billingCustomerId])
  @@index([status])
  @@index([companyId, status])
  @@map("company_subscriptions")
}

model BillingCustomer {
  id                 Int                   @id @default(autoincrement())
  companyId          Int                   @map("company_id")
  ownerUserId        Int?                  @map("owner_user_id")
  billingProvider    BillingProvider       @default(PAYMONGO) @map("billing_provider")
  externalCustomerId String                @unique @map("external_customer_id")
  email              String
  name               String
  phone              String?
  metadata           Json?
  rawProviderPayload Json?                 @map("raw_provider_payload")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerUser          User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  subscriptions      CompanySubscription[]

  @@unique([companyId, billingProvider])
  @@index([ownerUserId])
  @@map("billing_customers")
}

model SubscriptionInvoice {
  id                      Int                 @id @default(autoincrement())
  companySubscriptionId   Int                 @map("company_subscription_id")
  billingProvider         BillingProvider     @default(PAYMONGO) @map("billing_provider")
  externalInvoiceId       String              @unique @map("external_invoice_id")
  externalPaymentIntentId String?             @map("external_payment_intent_id")
  status                  String
  billingReason           String?             @map("billing_reason")
  currency                String              @default("PHP")
  amountDueInCents        Int?                @map("amount_due_in_cents")
  amountPaidInCents       Int?                @map("amount_paid_in_cents")
  dueAt                   DateTime?           @map("due_at")
  paidAt                  DateTime?           @map("paid_at")
  finalizedAt             DateTime?           @map("finalized_at")
  periodStartAt           DateTime?           @map("period_start_at")
  periodEndAt             DateTime?           @map("period_end_at")
  rawProviderPayload      Json?               @map("raw_provider_payload")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  companySubscription     CompanySubscription @relation(fields: [companySubscriptionId], references: [id], onDelete: Cascade)

  @@index([companySubscriptionId])
  @@index([status])
  @@map("subscription_invoices")
}

model BillingPaymentMethod {
  id                      Int                  @id @default(autoincrement())
  companyId               Int                  @map("company_id")
  companySubscriptionId   Int?                 @map("company_subscription_id")
  billingProvider         BillingProvider      @default(PAYMONGO) @map("billing_provider")
  externalPaymentMethodId String               @unique @map("external_payment_method_id")
  type                    String
  brand                   String?
  last4                   String?
  expMonth                Int?                 @map("exp_month")
  expYear                 Int?                 @map("exp_year")
  isDefault               Boolean              @default(false) @map("is_default")
  metadata                Json?
  rawProviderPayload      Json?                @map("raw_provider_payload")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companySubscription     CompanySubscription? @relation(fields: [companySubscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companySubscriptionId])
  @@index([isDefault])
  @@map("billing_payment_methods")
}

model BillingWebhookEvent {
  id                 BigInt                  @id @default(autoincrement())
  billingProvider    BillingProvider         @default(PAYMONGO) @map("billing_provider")
  eventId            String                  @map("event_id")
  eventType          String                  @map("event_type")
  isLiveMode         Boolean                 @default(false) @map("is_live_mode")
  signature          String?
  payload            Json
  processingStatus   WebhookProcessingStatus @default(PENDING) @map("processing_status")
  processingAttempts Int                     @default(0) @map("processing_attempts")
  processedAt        DateTime?               @map("processed_at")
  lastError          String?                 @map("last_error")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@unique([billingProvider, eventId])
  @@index([eventType])
  @@index([processingStatus])
  @@map("billing_webhook_events")
}

model EmailVerificationCode {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @map("user_id")
  email        String
  purpose      VerificationPurpose @default(SIGNUP)
  codeHash     String              @map("code_hash")
  expiresAt    DateTime            @map("expires_at")
  consumedAt   DateTime?           @map("consumed_at")
  resendCount  Int                 @default(0) @map("resend_count")
  attemptCount Int                 @default(0) @map("attempt_count")
  lastSentAt   DateTime            @default(now()) @map("last_sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
  @@map("email_verification_codes")
}

// =========================================================
// Enums
// =========================================================

enum SystemRole {
  SUPER_ADMIN
  STANDARD
}

enum MembershipRole {
  ADMIN
  USER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CompanyRoleType {
  ADMIN
  USER
  CUSTOM
}

enum AccessScopeLevel {
  COMPANY
  SATELLITE
  BRANCH
}

enum CompanyUnitType {
  HEAD_OFFICE
  BRANCH
  SATELLITE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum CompanyStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum TaxpayerType {
  INDIVIDUAL
  NON_INDIVIDUAL
}

enum BillingProvider {
  PAYMONGO
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  INCOMPLETE_CANCELED
  EXPIRED
  CANCELED
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum VerificationPurpose {
  SIGNUP
  EMAIL_CHANGE
  PASSWORD_RESET
}
