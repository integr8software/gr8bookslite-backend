generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// Core Auth
// =========================================================

model User {
  id                    Int                     @id @default(autoincrement())
  email                 String                  @unique
  passwordHash          String?                 @map("password_hash")
  name                  String
  contactNumber         String?                 @map("contact_number")
  avatarFileName        String?                 @map("avatar_file_name")
  avatarMimeType        String?                 @map("avatar_mime_type")
  avatarStoragePath     String?                 @map("avatar_storage_path")
  avatarPublicUrl       String?                 @map("avatar_public_url")
  systemRole            SystemRole              @default(STANDARD) @map("system_role")
  status                UserStatus              @default(PENDING_VERIFICATION)
  emailVerifiedAt       DateTime?               @map("email_verified_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime?               @updatedAt @map("updated_at")
  verificationCodes     EmailVerificationCode[]
  memberships           Membership[]
  invitedMemberships    Membership[]            @relation("MembershipInvitedBy")
  createdAuditLogs      AuditLog[]              @relation("AuditActor")
  onboardingDraft       UserOnboardingDraft?
  authIdentities        UserAuthIdentity[]
  billingCustomers      BillingCustomer[]
  billingPaymentMethods BillingPaymentMethod[]
  createdCompanies      Company[]               @relation("CompanyCreatedBy")
  tablePreferences      UserTablePreference[]
  sidebarPreferences    UserSidebarPreference[]

  @@map("users")
}

model UserAuthIdentity {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  provider       AuthProvider
  providerUserId String?      @map("provider_user_id")
  email          String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([email])
  @@map("user_auth_identities")
}

model AuthSessionHandoff {
  id          Int       @id @default(autoincrement())
  codeHash    String    @unique @map("code_hash")
  accessToken String    @map("access_token")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_session_handoffs")
}

// =========================================================
// Company & Access Control
// =========================================================

model Company {
  id                    Int                     @id @default(autoincrement())
  name                  String
  slug                  String                  @unique
  legalName             String?                 @map("legal_name")
  companyCode           String?                 @unique @map("company_code")
  taxpayerType          TaxpayerType?           @map("taxpayer_type")
  ownerLastName         String?                 @map("owner_last_name")
  ownerFirstName        String?                 @map("owner_first_name")
  ownerMiddleName       String?                 @map("owner_middle_name")
  organizationType      String?                 @map("organization_type")
  organizationTypeOther String?                 @map("organization_type_other")
  logoFileName          String?                 @map("logo_file_name")
  logoMimeType          String?                 @map("logo_mime_type")
  logoStoragePath       String?                 @map("logo_storage_path")
  logoPublicUrl         String?                 @map("logo_public_url")
  address               String?
  tin                   String?
  email                 String?
  website               String?
  contactNumber         String?                 @map("contact_number")
  reportStartDate       DateTime?               @map("report_start_date")
  reportEndDate         DateTime?               @map("report_end_date")
  createdByUserId       Int?                    @map("created_by_user_id")
  isActive              Boolean                 @default(true) @map("is_active")
  status                CompanyStatus           @default(PENDING)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  subscriptions         CompanySubscription[]
  billingCustomers      BillingCustomer[]
  billingPaymentMethods BillingPaymentMethod[]
  memberships           Membership[]
  roles                 CompanyRole[]
  sidebarPreferences    UserSidebarPreference[]
  units                 CompanyUnit[]
  formSignatorySetups   FormSignatorySetup[]
  chartAccounts         ChartAccount[]
  bankAccounts          BankAccount[]
  defaultAccounts       DefaultAccount[]
  terms                 Term[]
  paymentTypes          PaymentType[]
  discounts             Discount[]
  userTablePreferences  UserTablePreference[]
  auditLogs             AuditLog[]
  onboardingDrafts      UserOnboardingDraft[]   @relation("ProvisionedOnboardingCompany")
  createdByUser         User?                   @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@map("companies")
}

model CompanyUnit {
  id                     Int                         @id @default(autoincrement())
  companyId              Int                         @map("company_id")
  parentUnitId           Int?                        @map("parent_unit_id")
  type                   CompanyUnitType
  code                   String?
  name                   String
  tin                    String?
  address                String?
  contactNumber          String?                     @map("contact_number")
  email                  String?
  isActive               Boolean                     @default(true) @map("is_active")
  inheritsCompanyProfile Boolean                     @default(false) @map("inherits_company_profile")
  canTransactSales       Boolean                     @default(false) @map("can_transact_sales")
  canHoldInventory       Boolean                     @default(false) @map("can_hold_inventory")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  company                Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentUnit             CompanyUnit?                @relation("CompanyUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits             CompanyUnit[]               @relation("CompanyUnitHierarchy")
  membershipAccess       MembershipUnitAccess[]
  formSignatorySetups    FormSignatorySetup[]
  transactionNumbers     TransactionNumberSequence[]
  sidebarPreferences     UserSidebarPreference[]
  roles                  CompanyRole[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentUnitId])
  @@map("company_units")
}

model Membership {
  userId              Int                    @map("user_id")
  companyId           Int                    @map("company_id")
  role                MembershipRole         @default(USER)
  companyRoleId       Int?                   @map("company_role_id")
  status              MembershipStatus       @default(ACTIVE)
  accessScope         AccessScopeLevel       @default(COMPANY) @map("access_scope")
  invitedByUserId     Int?                   @map("invited_by_user_id")
  invitedAt           DateTime?              @map("invited_at")
  joinedAt            DateTime?              @map("joined_at")
  suspendedAt         DateTime?              @map("suspended_at")
  lastAccessedAt      DateTime?              @map("last_accessed_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyRole         CompanyRole?           @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)
  invitedBy           User?                  @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  permissionOverrides MembershipPermission[]
  unitAccess          MembershipUnitAccess[]

  @@id([userId, companyId])
  @@index([companyId])
  @@index([companyRoleId])
  @@index([status])
  @@index([companyId, status])
  @@map("memberships")
}

model UserTablePreference {
  id            BigInt   @id @default(autoincrement())
  userId        Int      @map("user_id")
  companyId     Int      @map("company_id")
  moduleKey     String   @map("module_key") @db.VarChar(120)
  configuration Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, moduleKey])
  @@index([companyId])
  @@map("user_table_preferences")
}

model MembershipUnitAccess {
  userId        Int          @map("user_id")
  companyId     Int          @map("company_id")
  unitId        Int          @map("unit_id")
  companyRoleId Int?         @map("company_role_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  membership    Membership   @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)
  unit          CompanyUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  companyRole   CompanyRole? @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)

  @@id([userId, companyId, unitId])
  @@index([companyId, unitId])
  @@index([companyRoleId])
  @@map("membership_unit_access")
}

model CompanyRole {
  id          Int                     @id @default(autoincrement())
  companyId   Int                     @map("company_id")
  unitId      Int?                    @map("unit_id")
  code        String
  name        String
  description String?
  roleType    CompanyRoleType         @default(CUSTOM) @map("role_type")
  scopeLevel  AccessScopeLevel        @default(COMPANY) @map("scope_level")
  isSystem    Boolean                 @default(false) @map("is_system")
  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit        CompanyUnit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberships Membership[]
  unitAccess  MembershipUnitAccess[]
  permissions CompanyRolePermission[]

  @@unique([companyId, unitId, code])
  @@index([companyId, isActive])
  @@index([unitId])
  @@map("company_roles")
}

model Module {
  id                    Int                         @id @default(autoincrement())
  code                  String                      @unique
  name                  String
  description           String?
  icon                  String?                     @map("default_icon_name")
  category              ModuleCategory              @default(STANDARD)
  type                  Json                        @default("[]") @map("module_types")
  isActive              Boolean                     @default(true) @map("is_active")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  permissions           Permission[]
  formSignatorySetups   FormSignatorySetup[]
  transactionNumbers    TransactionNumberSequence[]
  subscriptionPlanLinks SubscriptionPlanModule[]
  systemLinks           ModuleSystemModule[]
  systemSidebar         ModuleSystemSidebar[]

  @@map("modules")
}

model ModuleSystem {
  id           Int                      @id @default(autoincrement())
  code         String                   @unique
  name         String
  description  String?
  sortOrder    Int                      @default(0) @map("sort_order")
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  modules      ModuleSystemModule[]
  planLinks    SubscriptionPlanSystem[]
  sidebarItems ModuleSystemSidebar[]

  @@index([isActive, sortOrder])
  @@map("module_systems")
}

model ModuleSystemModule {
  id        Int          @id @default(autoincrement())
  systemId  Int          @map("system_id")
  moduleId  Int          @map("module_id")
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  system    ModuleSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  module    Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([systemId, moduleId])
  @@index([moduleId, isActive])
  @@index([systemId, isActive, sortOrder])
  @@map("module_system_modules")
}

model ModuleSystemSidebar {
  id          Int                   @id @default(autoincrement())
  systemId    Int                   @map("system_id")
  parentId    Int?                  @map("parent_id")
  moduleId    Int?                  @map("module_id")
  itemType    SidebarItemType       @map("item_type")
  key         String
  label       String
  description String?
  iconName    String?               @map("icon_name")
  sortOrder   Int                   @default(0) @map("sort_order")
  isVisible   Boolean               @default(true) @map("is_visible")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  system      ModuleSystem          @relation(fields: [systemId], references: [id], onDelete: Cascade)
  module      Module?               @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  parent      ModuleSystemSidebar?  @relation("ModuleSystemSidebarTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ModuleSystemSidebar[] @relation("ModuleSystemSidebarTree")

  @@unique([systemId, key])
  @@index([systemId, parentId, sortOrder])
  @@index([moduleId])
  @@map("module_system_sidebar")
}

model PlatformVersion {
  id             Int      @id @default(1)
  currentVersion String   @map("current_version")
  checksum       String
  status         String   @default("APPLIED")
  appliedBy      String?  @map("applied_by")
  appliedAt      DateTime @default(now()) @map("applied_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("platform_versions")
}

model Permission {
  id                     Int                     @id @default(autoincrement())
  moduleId               Int                     @map("module_id")
  code                   String                  @unique
  name                   String
  description            String?
  scopeLevel             AccessScopeLevel        @default(COMPANY) @map("scope_level")
  requiresCompanyContext Boolean                 @default(true) @map("requires_company_context")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  module                 Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rolePermissions        CompanyRolePermission[]
  membershipOverrides    MembershipPermission[]

  @@index([moduleId, isActive])
  @@map("permissions")
}

model CompanyRolePermission {
  id            Int         @id @default(autoincrement())
  companyRoleId Int         @map("company_role_id")
  permissionId  Int         @map("permission_id")
  canView       Boolean     @default(false) @map("can_view")
  canCreate     Boolean     @default(false) @map("can_create")
  canUpdate     Boolean     @default(false) @map("can_update")
  canCancel     Boolean     @default(false) @map("can_cancel")
  canUncancel   Boolean     @default(false) @map("can_uncancel")
  canExport     Boolean     @default(false) @map("can_export")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  companyRole   CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([companyRoleId, permissionId])
  @@index([permissionId])
  @@map("company_role_permissions")
}

model MembershipPermission {
  id                  Int        @id @default(autoincrement())
  membershipUserId    Int        @map("membership_user_id")
  membershipCompanyId Int        @map("membership_company_id")
  permissionId        Int        @map("permission_id")
  canView             Boolean?   @map("can_view")
  canCreate           Boolean?   @map("can_create")
  canUpdate           Boolean?   @map("can_update")
  canCancel           Boolean?   @map("can_cancel")
  canUncancel         Boolean?   @map("can_uncancel")
  canExport           Boolean?   @map("can_export")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  membership          Membership @relation(fields: [membershipUserId, membershipCompanyId], references: [userId, companyId], onDelete: Cascade)
  permission          Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipUserId, membershipCompanyId, permissionId])
  @@index([permissionId])
  @@index([membershipCompanyId])
  @@map("membership_permissions")
}

model UserSidebarPreference {
  id                Int         @id @default(autoincrement())
  companyId         Int         @map("company_id")
  branchUnitId      Int         @map("branch_unit_id")
  userId            Int         @map("user_id")
  itemKey           String      @map("item_key") @db.VarChar(160)
  parentItemKey     String?     @map("parent_item_key") @db.VarChar(160)
  hasParentOverride Boolean     @default(false) @map("has_parent_override")
  isHidden          Boolean     @default(false) @map("is_hidden")
  sortOrder         Int?        @map("sort_order")
  isPinned          Boolean     @default(false) @map("is_pinned")
  isCollapsed       Boolean     @default(false) @map("is_collapsed")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchUnit        CompanyUnit @relation(fields: [branchUnitId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchUnitId, userId, itemKey], map: "user_sidebar_preferences_scope_item_uq")
  @@index([userId, companyId, branchUnitId], map: "user_sidebar_preferences_scope_idx")
  @@map("user_sidebar_preferences")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  companyId   Int?     @map("company_id")
  actorUserId Int?     @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Region {
  id                 Int                @id @default(autoincrement())
  psgcCode           String             @unique @map("psgc_code") @db.VarChar(20)
  code               String             @unique @map("region_code") @db.VarChar(20)
  name               String
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  provinces          Province[]
  cityMunicipalities CityMunicipality[]
  barangays          Barangay[]

  @@index([name])
  @@map("regions")
}

model Province {
  id                 Int                @id @default(autoincrement())
  psgcCode           String             @unique @map("psgc_code") @db.VarChar(20)
  code               String             @unique @map("province_code") @db.VarChar(20)
  name               String
  regionCode         String             @map("region_code") @db.VarChar(20)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  region             Region             @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  cityMunicipalities CityMunicipality[]
  barangays          Barangay[]

  @@index([regionCode])
  @@index([name])
  @@map("provinces")
}

model CityMunicipality {
  id           Int        @id @default(autoincrement())
  psgcCode     String     @unique @map("psgc_code") @db.VarChar(20)
  code         String     @unique @map("city_municipality_code") @db.VarChar(20)
  name         String
  regionCode   String     @map("region_code") @db.VarChar(20)
  provinceCode String     @map("province_code") @db.VarChar(20)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  region       Region     @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  province     Province   @relation(fields: [provinceCode], references: [code], onDelete: Restrict)
  barangays    Barangay[]

  @@index([regionCode])
  @@index([provinceCode])
  @@index([name])
  @@map("city_municipalities")
}

model Barangay {
  id                   Int              @id @default(autoincrement())
  psgcCode             String           @unique @map("psgc_code") @db.VarChar(20)
  code                 String           @unique @map("barangay_code") @db.VarChar(20)
  name                 String
  regionCode           String           @map("region_code") @db.VarChar(20)
  provinceCode         String           @map("province_code") @db.VarChar(20)
  cityMunicipalityCode String           @map("city_municipality_code") @db.VarChar(20)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  region               Region           @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  province             Province         @relation(fields: [provinceCode], references: [code], onDelete: Restrict)
  cityMunicipality     CityMunicipality @relation(fields: [cityMunicipalityCode], references: [code], onDelete: Restrict)

  @@index([regionCode])
  @@index([provinceCode])
  @@index([cityMunicipalityCode])
  @@index([name])
  @@map("barangays")
}

model AlphanumericTaxCode {
  id              Int      @id @default(autoincrement())
  sourceKey       String   @unique @map("source_key") @db.VarChar(40)
  transactionType String   @map("transaction_type") @db.VarChar(40)
  taxType         String   @map("tax_type") @db.VarChar(40)
  taxCode         String   @map("tax_code") @db.VarChar(40)
  taxDescription  String   @map("tax_description")
  taxRate         Decimal  @map("tax_rate") @db.Decimal(8, 4)
  taxAlias        String?  @map("tax_alias") @db.VarChar(40)
  atc             String?  @db.VarChar(40)
  officialAtcCode String?  @map("official_atc_code") @db.VarChar(40)
  natureOfIncome  String?  @map("nature_of_income")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([transactionType])
  @@index([taxType])
  @@index([taxCode])
  @@index([officialAtcCode])
  @@map("alphanumeric_tax_codes")
}

model FormSignatorySetup {
  id        Int                @id @default(autoincrement())
  companyId Int                @map("company_id")
  unitId    Int                @map("unit_id")
  moduleId  Int                @map("module_id")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit      CompanyUnit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rows      FormSignatoryRow[]

  @@unique([companyId, unitId, moduleId])
  @@index([companyId])
  @@index([unitId])
  @@index([moduleId])
  @@map("form_signatory_setups")
}

model FormSignatoryRow {
  id                  Int                @id @default(autoincrement())
  setupId             Int                @map("setup_id")
  label               String
  name                String
  position            String?
  signatureName       String?            @map("signature_name")
  signatureImage      String?            @map("signature_image") @db.Text
  signatureValidUntil DateTime?          @map("signature_valid_until")
  isThisTemporary     Boolean?           @map("is_this_temporary")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  setup               FormSignatorySetup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
  @@map("form_signatory_rows")
}

model TransactionNumberSequence {
  id             Int                        @id @default(autoincrement())
  branchUnitId   Int                        @map("branch_unit_id")
  moduleId       Int                        @map("module_id")
  inputMode      TransactionNumberInputMode @default(AUTO) @map("input_mode")
  prefix         String
  suffix         String                     @default("")
  padding        Int                        @default(6)
  startingNumber Int                        @default(1) @map("starting_number")
  currentNumber  Int                        @default(1) @map("current_number")
  status         TransactionNumberStatus    @default(ACTIVE)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  branchUnit     CompanyUnit                @relation(fields: [branchUnitId], references: [id], onDelete: Cascade)
  module         Module                     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, branchUnitId])
  @@index([branchUnitId])
  @@index([moduleId])
  @@map("transaction_number_sequences")
}

model ChartAccount {
  id                                     BigInt             @id @default(autoincrement())
  companyId                              Int                @map("company_id")
  parentAccountId                        BigInt?            @map("parent_account_id")
  accountCode                            String             @map("account_code") @db.VarChar(20)
  accountTitle                           String             @map("account_title") @db.VarChar(250)
  accountLevel                           ChartAccountLevel  @map("account_level")
  accountType                            ChartAccountType?  @map("account_type")
  accountNature                          AccountNature?     @map("account_nature")
  accountGroup                           Json?              @map("account_group")
  statementSection                       String?            @map("statement_section") @db.VarChar(250)
  reportAlias                            String?            @map("report_alias") @db.VarChar(250)
  description                            String?            @db.VarChar(500)
  isPostingAccount                       Boolean            @default(false) @map("is_posting_account")
  withSubsidiary                         Boolean            @default(false) @map("with_subsidiary")
  contraAccount                          Boolean            @default(false) @map("contra_account")
  showTotal                              Boolean            @default(false) @map("show_total")
  orderNo                                Int?               @map("order_no")
  status                                 ChartAccountStatus @default(ACTIVE)
  currencyCode                           String?            @map("currency_code") @db.VarChar(10)
  whoCreated                             String?            @map("who_created") @db.VarChar(50)
  whoModified                            String?            @map("who_modified") @db.VarChar(50)
  deletedAt                              DateTime?          @map("deleted_at")
  createdAt                              DateTime           @default(now()) @map("created_at")
  updatedAt                              DateTime           @updatedAt @map("updated_at")
  company                                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentAccount                          ChartAccount?      @relation("ChartAccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts                          ChartAccount[]     @relation("ChartAccountHierarchy")
  bankAccounts                           BankAccount[]
  discounts                              Discount[]
  defaultExpenseAccounts                 DefaultAccount[]   @relation("DefaultAccountExpenseCoa")
  defaultRevenueAccounts                 DefaultAccount[]   @relation("DefaultAccountRevenueCoa")
  defaultAssetAccounts                   DefaultAccount[]   @relation("DefaultAccountAssetCoa")
  defaultAccumulatedDepreciationAccounts DefaultAccount[]   @relation("DefaultAccountAccumulatedDepreciationCoa")

  @@unique([companyId, accountCode], map: "chart_accounts_company_account_code_key")
  @@index([parentAccountId], map: "chart_accounts_parent_account_id_idx")
  @@index([status], map: "chart_accounts_status_idx")
  @@index([companyId, status], map: "chart_accounts_company_status_idx")
  @@map("chart_accounts")
}

model DefaultAccount {
  id                           BigInt                     @id @default(autoincrement())
  companyId                    Int                        @map("company_id")
  type                         DefaultAccountTemplateType
  name                         String                     @db.VarChar(250)
  description                  String?                    @db.VarChar(500)
  status                       ChartAccountStatus         @default(ACTIVE)
  expenseCoaId                 BigInt?                    @map("expense_coa_id")
  revenueCoaId                 BigInt?                    @map("revenue_coa_id")
  assetCoaId                   BigInt?                    @map("asset_coa_id")
  accumulatedDepreciationCoaId BigInt?                    @map("accumulated_depreciation_coa_id")
  createdByUserId              Int?                       @map("created_by_user_id")
  updatedByUserId              Int?                       @map("updated_by_user_id")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")
  deletedAt                    DateTime?                  @map("deleted_at")
  company                      Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseCoa                   ChartAccount?              @relation("DefaultAccountExpenseCoa", fields: [expenseCoaId], references: [id], onDelete: Restrict)
  revenueCoa                   ChartAccount?              @relation("DefaultAccountRevenueCoa", fields: [revenueCoaId], references: [id], onDelete: Restrict)
  assetCoa                     ChartAccount?              @relation("DefaultAccountAssetCoa", fields: [assetCoaId], references: [id], onDelete: Restrict)
  accumulatedDepreciationCoa   ChartAccount?              @relation("DefaultAccountAccumulatedDepreciationCoa", fields: [accumulatedDepreciationCoaId], references: [id], onDelete: Restrict)

  @@unique([companyId, type, name], map: "default_accounts_company_type_name_key")
  @@index([companyId, status], map: "default_accounts_company_status_idx")
  @@index([expenseCoaId], map: "default_accounts_expense_coa_id_idx")
  @@index([revenueCoaId], map: "default_accounts_revenue_coa_id_idx")
  @@index([assetCoaId], map: "default_accounts_asset_coa_id_idx")
  @@index([accumulatedDepreciationCoaId], map: "default_accounts_accumulated_depreciation_coa_id_idx")
  @@map("default_accounts")
}

model BankAccount {
  id                   BigInt             @id @default(autoincrement())
  companyId            Int                @map("company_id")
  coaId                BigInt             @map("coa_id")
  bankName             String             @map("bank_name") @db.VarChar(100)
  branch               String?            @db.VarChar(100)
  accountNumber        String             @map("account_number") @db.VarChar(100)
  accountName          String             @map("account_name") @db.VarChar(250)
  accountType          String?            @map("account_type") @db.VarChar(50)
  seriesStart          String?            @map("series_start") @db.VarChar(50)
  seriesEnd            String?            @map("series_end") @db.VarChar(50)
  seriesDigits         Int?               @map("series_digits")
  currencyCode         String?            @map("currency_code") @db.VarChar(10)
  currencyExchangeRate Decimal?           @map("currency_exchange_rate") @db.Decimal(18, 2)
  isDefault            Boolean            @default(false) @map("is_default")
  status               ChartAccountStatus @default(ACTIVE)
  createdByUserId      Int?               @map("created_by_user_id")
  updatedByUserId      Int?               @map("updated_by_user_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coa                  ChartAccount       @relation(fields: [coaId], references: [id], onDelete: Restrict)

  @@index([coaId], map: "bank_accounts_coa_id_idx")
  @@index([status], map: "bank_accounts_status_idx")
  @@index([companyId, status], map: "bank_accounts_company_status_idx")
  @@index([companyId, bankName, branch, accountNumber], map: "bank_accounts_company_bank_branch_number_idx")
  @@map("bank_accounts")
}

model Term {
  id              BigInt       @id @default(autoincrement())
  companyId       Int          @map("company_id")
  name            String       @db.VarChar(150)
  description     String?      @db.VarChar(500)
  dateMode        TermDateMode @map("date_mode")
  period          Int
  status          TermStatus   @default(ACTIVE)
  createdByUserId Int?         @map("created_by_user_id")
  updatedByUserId Int?         @map("updated_by_user_id")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "terms_company_id_idx")
  @@index([companyId, status], map: "terms_company_status_idx")
