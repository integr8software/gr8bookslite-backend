generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                     @id @default(autoincrement())
  email             String                  @unique
  passwordHash      String                  @map("password_hash")
  name              String
  dateOfBirth       DateTime?               @map("date_of_birth")
  systemRole        SystemRole              @default(STANDARD) @map("system_role")
  status            UserStatus              @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?               @map("email_verified_at")
  verificationCodes EmailVerificationCode[]
  memberships       Membership[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@map("users")
}

model Company {
  id               Int                   @id @default(autoincrement())
  name             String
  slug             String                @unique
  isActive         Boolean               @default(true) @map("is_active")
  status           CompanyStatus         @default(PENDING)
  memberships      Membership[]
  tenantConnection TenantConnection?
  subscriptions    CompanySubscription[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@map("companies")
}

model Membership {
  userId    Int            @map("user_id")
  companyId Int            @map("company_id")
  role      MembershipRole @default(USER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])

  @@map("memberships")
}

model TenantConnection {
  companyId     Int          @id @map("company_id")
  dbName        String       @unique @map("db_name")
  databaseUrl   String       @map("database_url")
  status        TenantStatus @default(PENDING)
  schemaVersion String?      @map("schema_version")
  lastCheckedAt DateTime?    @map("last_checked_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("tenant_connections")
}

model SubscriptionPlan {
  id            Int                   @id @default(autoincrement())
  code          String                @unique
  name          String
  description   String?
  trialDays     Int                   @default(15) @map("trial_days")
  isActive      Boolean               @default(true) @map("is_active")
  subscriptions CompanySubscription[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model CompanySubscription {
  id                 Int                @id @default(autoincrement())
  companyId          Int                @map("company_id")
  subscriptionPlanId Int                @map("subscription_plan_id")
  status             SubscriptionStatus @default(TRIALING)
  startsAt           DateTime           @default(now()) @map("starts_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  endsAt             DateTime?          @map("ends_at")
  canceledAt         DateTime?          @map("canceled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([subscriptionPlanId])
  @@index([status])

  @@map("company_subscriptions")
}

model EmailVerificationCode {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @map("user_id")
  email        String
  purpose      VerificationPurpose @default(SIGNUP)
  codeHash     String              @map("code_hash")
  expiresAt    DateTime            @map("expires_at")
  consumedAt   DateTime?           @map("consumed_at")
  resendCount  Int                 @default(0) @map("resend_count")
  attemptCount Int                 @default(0) @map("attempt_count")
  lastSentAt   DateTime            @default(now()) @map("last_sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])

  @@map("email_verification_codes")
}

enum SystemRole {
  SUPER_ADMIN
  STANDARD
}

enum MembershipRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum CompanyStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  SUSPENDED
}

enum TenantStatus {
  PENDING
  ACTIVE
  FAILED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

enum VerificationPurpose {
  SIGNUP
  EMAIL_CHANGE
  PASSWORD_RESET
}
