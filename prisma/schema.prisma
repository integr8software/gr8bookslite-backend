// =========================================================
// Billing
// =========================================================

model SubscriptionPlan {
  id               Int                            @id @default(autoincrement())
  code             String                         @unique
  name             String
  description      String?
  currency         String                         @default("PHP")
  billingProvider  BillingProvider                @default(PAYMONGO) @map("billing_provider")
  billingMetadata  Json?                          @map("billing_metadata")
  scope            SubscriptionPlanScope          @default(ONBOARDING)
  status           SubscriptionPlanStatus         @default(ACTIVE)
  trialDays        Int                            @default(15) @map("trial_days")
  isActive         Boolean                        @default(true) @map("is_active")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  prices           SubscriptionPlanPrice[]
  usageRules       SubscriptionPlanUsageRule[]
  discountTiers    SubscriptionPlanDiscountTier[]
  modules          SubscriptionPlanModule[]
  systems          SubscriptionPlanSystem[]
  subscriptions    CompanySubscription[]
  onboardingDrafts UserOnboardingDraft[]

  @@index([scope, isActive], map: "subscription_plans_scope_is_active_idx")
  @@map("subscription_plans")
}

model SubscriptionPlanPrice {
  id                   Int                   @id @default(autoincrement())
  subscriptionPlanId   Int                   @map("subscription_plan_id")
  billingCycle         BillingCycle          @map("billing_cycle")
  intervalCount        Int                   @default(1) @map("interval_count")
  intervalUnit         BillingIntervalUnit   @map("interval_unit")
  priceInCents         Int                   @map("price_in_cents")
  compareAtInCents     Int?                  @map("compare_at_in_cents")
  externalPlanId       String?               @unique @map("external_plan_id")
  billingMetadata      Json?                 @map("billing_metadata")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  subscriptionPlan     SubscriptionPlan      @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  companySubscriptions CompanySubscription[]

  @@unique([subscriptionPlanId, billingCycle])
  @@index([billingCycle, isActive])
  @@map("subscription_plan_prices")
}

model SubscriptionPlanUsageRule {
  id                 Int                     @id @default(autoincrement())
  subscriptionPlanId Int                     @map("subscription_plan_id")
  metric             SubscriptionUsageMetric
  freeCount          Int                     @default(0) @map("free_count")
  unitPriceInCents   Int                     @default(0) @map("unit_price_in_cents")
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  subscriptionPlan   SubscriptionPlan        @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPlanId, metric])
  @@index([metric, isActive])
  @@map("subscription_plan_usage_rules")
}

model SubscriptionPlanDiscountTier {
  id                 Int                     @id @default(autoincrement())
  subscriptionPlanId Int                     @map("subscription_plan_id")
  metric             SubscriptionUsageMetric
  thresholdCount     Int                     @map("threshold_count")
  discountPercent    Decimal                 @map("discount_percent") @db.Decimal(5, 2)
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  subscriptionPlan   SubscriptionPlan        @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPlanId, metric, thresholdCount], map: "subscription_plan_discount_tiers_subscription_plan_id_metric_th")
  @@index([metric, thresholdCount, isActive], map: "subscription_plan_discount_tiers_metric_threshold_count_is_acti")
  @@map("subscription_plan_discount_tiers")
}

model SubscriptionPlanModule {
  id                 Int              @id @default(autoincrement())
  subscriptionPlanId Int              @map("subscription_plan_id")
  moduleId           Int              @map("module_id")
  isEnabled          Boolean          @default(true) @map("is_enabled")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  module             Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPlanId, moduleId])
  @@index([moduleId, isEnabled])
  @@map("subscription_plan_modules")
}

model SubscriptionPlanSystem {
  id                 Int              @id @default(autoincrement())
  subscriptionPlanId Int              @map("subscription_plan_id")
  systemId           Int              @map("system_id")
  isEnabled          Boolean          @default(true) @map("is_enabled")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  system             ModuleSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPlanId, systemId])
  @@index([systemId, isEnabled])
  @@index([subscriptionPlanId, isEnabled])
  @@map("subscription_plan_systems")
}

